# ---------------------------------------------------------------------------
# Trbhh environment. Copy to .env and fill in real values before deploying.
# ---------------------------------------------------------------------------

# Database (used by docker-compose to provision MySQL and by the app)
DB_NAME=trbhhdb
DB_USER=trbhh
DB_PASSWORD=change_this_strong_password
DB_ROOT_PASSWORD=change_this_strong_root_password

# App runtime
# DATABASE_URL — set this to your REAL database to connect the app to it.
#   • DB on the SAME VPS (MySQL on the host): use host.docker.internal
#       DATABASE_URL="mysql://DBUSER:DBPASS@host.docker.internal:3306/DBNAME"
#     (the DB user must be allowed from the docker network, and MySQL
#      bind-address must not be limited to 127.0.0.1 only)
#   • Bundled test DB (docker compose --profile localdb up -d):
#       DATABASE_URL="mysql://trbhh:change_this_strong_password@db:3306/trbhhdb"
# URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL="mysql://DBUSER:DBPASS@host.docker.internal:3306/DBNAME"
REDIS_URL="redis://redis:6379"

# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=generate_a_64_char_hex_secret

# Media is served same-origin via the /media route (leave NEXT_PUBLIC_MEDIA_BASE empty).
# LEGACY_MEDIA_BASE proxies images not yet copied to this server from the original site.
# After copying the storage folder to the VPS, images are served locally automatically.
NEXT_PUBLIC_MEDIA_BASE=
LEGACY_MEDIA_BASE=https://trbhh.com
# Directory for uploaded media (mounted as a volume in docker-compose)
STORAGE_DIR=/app/storage

# Host port the app is published on (default 8080). Access: http://SERVER_IP:APP_PORT
APP_PORT=3080

# Production always forces Secure cookies. This option is only relevant to local HTTP development.
COOKIE_SECURE=false

# Al Rajhi Bank ARB hosted checkout. Keep electronic payment disabled until the
# Sandbox test succeeds. Never put these values in the database or Git.
PAYMENT_PROVIDER=alrajhi_arb
ALRAJHI_ENVIRONMENT=sandbox
# Values below intentionally retain the exact labels issued by the ARB portal.
ALRAJHI_MERCHANT_ID=
ALRAJHI_TERMINAL_ID=
ALRAJHI_TERMINAL_NAME=
ALRAJHI_TERMINAL_ALIAS_NAME=
ALRAJHI_TRANPORTAL_ID=
ALRAJHI_TRANPORTAL_PASSWORD=
ALRAJHI_TERMINAL_RESOURCE_KEY=
# Exact endpoints supplied by the bank for this terminal. Do not guess or reuse
# an endpoint from another merchant. The hosted checkout and supporting
# transactions (inquiry/refund/void) endpoints are deliberately separate.
ALRAJHI_PAYMENT_GATEWAY_URL=
ALRAJHI_TRANPORTAL_GATEWAY_URL=
ALRAJHI_HOSTED_PAYMENT_URL=
CALLBACK_URL=https://trbhh.sa/api/pay/callback/alrajhi_arb
RETURN_URL=https://trbhh.sa/payment/result
CANCEL_URL=https://trbhh.sa/payment/result?state=cancelled
# Generate with: openssl rand -hex 32
DATABASE_PAYMENT_SECRET=

# Optional: external category-classifier service to boost the built-in local
# keyword classifier (e.g. an image-analysis service the local one can't do).
# Leave EMPTY (default) — the site works fully offline with the local
# classifier only; nothing calls out to the internet. Only set this if you
# adopt a specific external service later.
EXTERNAL_CLASSIFIER_URL=

# Optional: advertising retargeting/lookalike-audience pixels. Each platform
# loads ONLY when its ID below is set — leave all empty (default) and nothing
# is added to the site. Get these from your own ad accounts:
#   Meta:     Business Manager → Events Manager → your Pixel ID (numeric)
#   Google:   Google Ads → Conversion ID, format "AW-XXXXXXXXX"
#   TikTok:   TikTok Ads Manager → Assets → Events → Pixel ID
#   Snapchat: Snapchat Ads Manager → Events Manager → Pixel ID
META_PIXEL_ID=
GOOGLE_ADS_ID=
TIKTOK_PIXEL_ID=
SNAP_PIXEL_ID=

# Salla custom OAuth: server-only. Leave empty until a demo store is prepared.
# The public origin has no path/trailing route; callback/webhook are derived.
SUPPLIER_PUBLIC_ORIGIN=https://trbhh.sa
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# Dedicated 32-byte key encoded as 64 hex characters; not AUTH_SECRET.
SUPPLIER_TOKEN_ENCRYPTION_KEY=
SALLA_WEBHOOK_SECRET=
# At least 32 random characters; bearer authorization for scheduled reconciliation.
SUPPLIER_RECONCILE_SECRET=
# Keep false. Live Salla order transport also requires a reviewed merchant contract.
SUPPLIER_ALLOW_LIVE_ORDERS=false

# Optional private credential for the independent invoice archive capture job.
# Use at least 32 random characters, separate from every other secret; keep only
# in the private deployment environment. Blank disables the worker endpoint.
# This captures pending records only; it does not issue invoices or enable sales.
FINANCE_CAPTURE_SECRET=

# Optional private credential for prospective invoice issuance; blank disables it.
# Use at least 32 random characters, distinct from FINANCE_CAPTURE_SECRET and
# all other credentials. Each approved policy also requires an authorized delegate.
# Configuring this does not enable purchasing, payments, supplier orders or a timer.
FINANCE_ISSUANCE_SECRET=

# CJdropshipping integration (server-only). Foundation/test-mode only; no real
# purchase is ever sent to CJ unless the central "Purchasing Enabled" admin switch
# is ON *and* SUPPLIER_ALLOW_LIVE_ORDERS=true. Leave blank until credentials exist.
# CJ access tokens are sealed with SUPPLIER_TOKEN_ENCRYPTION_KEY (reused).
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=
CJ_API_KEY=
# At least 32 random characters; verifies inbound CJ webhooks (HMAC or shared secret).
CJ_WEBHOOK_SECRET=
