generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  password   String
  user_name  String
  email      String?
  phone      String
  role_id    Int       @default(0)
  image      Int       @default(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  adsType          ads_adsType
  user_id          BigInt         @db.UnsignedBigInt
  city_id          BigInt         @db.UnsignedBigInt
  category_id      BigInt         @db.UnsignedBigInt
  title            String         @db.VarChar(255)
  detail           String         @db.Text
  video_path       String         @db.Text
  phoneAllow       Int            @default(0) @db.TinyInt
  commentAllow     Int            @default(0) @db.TinyInt
  adsSpecial       ads_adsSpecial
  state            ads_state      @default(dbgenerated("1"))
  Tactive          Int            @default(300)
  editAds          Int            @default(12)
  arc_msg          String?        @db.VarChar(225)
  country_id       Int?
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  status           Int            @default(1) @db.TinyInt
  store_only       Int            @default(0) @db.TinyInt
  trbhh_until      DateTime?      @db.DateTime(0)
  urgent_until     DateTime?      @db.DateTime(0)
  bumped_at        DateTime?      @db.DateTime(0)
  publish_at       DateTime?      @db.DateTime(0)
  paused_by_owner  Int            @default(0) @db.TinyInt
  stock_state      Int            @default(0) @db.TinyInt
  old_price        Float          @default(0)
  rent_period      String?        @db.VarChar(20)
  data_archive     String?
  data_delete      String?
  price            Float          @default(0)
  edit_date        String?
  sale_type        String?
  price_type       String?
  quantity_offered String?
  delivery_type    String?
  min_price        Float          @default(0)
  max_price        Float          @default(0)
  lat              String?
  lng              String?
  area_id          Int?
  count_share      Int            @default(0)
  subcategory_id   Int?
  end_date_price   String?
  start_date_price String?
  expires_at       DateTime? @db.DateTime(0)
  cat_reviewed     Int       @default(1) @db.TinyInt
  flag_terms       String?   @db.VarChar(400)
  profile_id       BigInt?
  is_realestate    Int       @default(0) @db.TinyInt
  re_type          String?   @db.VarChar(30)  // نوع العقار: شقة/فيلا/أرض/تجاري…
  re_area          Int?                        // المساحة بالمتر المربع
  re_license       String?   @db.VarChar(60)  // رقم ترخيص الإعلان العقاري (فال)
  re_plot          String?   @db.VarChar(40)  // رقم القطعة
  re_plan          String?   @db.VarChar(60)  // رقم المخطط
  re_deed          String?   @db.VarChar(60)  // رقم الصك
  re_beds          Int?                        // عدد غرف النوم
  re_baths         Int?                        // عدد دورات المياه
  re_floor         String?   @db.VarChar(20)  // الطابق/الدور
  re_age           Int?                        // عمر العقار (سنوات)
  re_facade        String?   @db.VarChar(20)  // واجهة العقار (شمالية/جنوبية…)
  re_street        Int?                        // عرض الشارع (م)
  re_furnished     Int?      @db.TinyInt      // مفروش؟ 1=نعم 0=لا

  @@index([category_id], map: "ads_category_id_foreign")
  @@index([city_id], map: "ads_city_id_foreign")
  @@index([user_id], map: "ads_user_id_foreign")
  @@index([expires_at], map: "ads_expires_at")
  @@index([status, state, bumped_at], map: "ads_listing_bumped")
  @@index([status, state, created_at], map: "ads_listing_created")
  @@index([cat_reviewed], map: "ads_cat_reviewed")
  @@index([profile_id], map: "ads_profile_id")
  @@index([is_realestate], map: "ads_is_realestate")
}

model profiles {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt    @db.UnsignedBigInt
  type       String    @default("personal") @db.VarChar(10)
  store_id   BigInt?   @db.UnsignedBigInt
  name       String?   @db.VarChar(120)
  phone      String?   @db.VarChar(24)
  whatsapp   String?   @db.VarChar(24)
  email      String?   @db.VarChar(120)
  handle     String?   @db.VarChar(32)
  avatar     Int       @default(0)
  color      String?   @db.VarChar(9)
  theme      String?   @db.VarChar(16)
  status     Int       @default(1) @db.TinyInt
  is_default Int       @default(0) @db.TinyInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  paid_until DateTime? @db.DateTime(0)

  @@index([user_id], map: "profiles_user")
  @@index([store_id], map: "profiles_store")
}

model ads_admins {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  image       Int       @default(0)
}

model ads_chats {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ads_id     Int
  user_id    Int
  chat       String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads_cities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  city_id    Int
  ads_id     Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads_prices {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String
  phone       String
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  start_date  String?
  end_date    String?
  image       String?
  video       String?
  views       Int       @default(0)
  count_views Int       @default(0)
  area_id     Int?
  ads         String?   @db.Text
  whatsapp    String?
  user_id     Int?
  transaction Int?
  status      Int       @default(1) @db.TinyInt
}

model ads_views {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    String
  ads_id     BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([ads_id], map: "ads_views_ads_id_foreign")
  @@index([user_id], map: "ads_views_user_id_foreign")
  @@index([ads_id, user_id], map: "ads_views_ad_user")
}

model areas {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  city_id    Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model categories {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  photo_path String    @db.Text
  is_active  String    @default("no") @db.VarChar(225)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  ordered    Int       @default(0)
}

model category__users {
  id          BigInt    @id @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  category_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@index([category_id], map: "category_user_category_id_foreign")
  @@index([user_id], map: "category_user_user_id_foreign")
}

model category_ads {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  count_day  Int
  price      Int       @default(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model category_pages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model chat_ads {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ads_id     Int
  ads_user   Int
  user_id    Int
  message    String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model chat_messages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  from_user  Int
  to_user    Int
  from_type  String
  to_type    String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model chats {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sender_id      Int       @default(0)
  reciver_id     Int       @default(0)
  message        String    @db.Text // widened at runtime (schema-sync): long chat messages
  is_read        Int       @default(0) @db.TinyInt
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  type_from_user String    @default("user")
  type_to_user   String    @default("user")
  chat_id        Int
}

model checkforupdate {
