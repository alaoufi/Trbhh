generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  password   String
  user_name  String
  email      String?
  phone      String
  role_id    Int       @default(0)
  image      Int       @default(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  adsType          ads_adsType
  user_id          BigInt         @db.UnsignedBigInt
  city_id          BigInt         @db.UnsignedBigInt
  category_id      BigInt         @db.UnsignedBigInt
  title            String         @db.VarChar(255)
  detail           String         @db.Text
  video_path       String         @db.Text
  phoneAllow       Int            @default(0) @db.TinyInt
  commentAllow     Int            @default(0) @db.TinyInt
  adsSpecial       ads_adsSpecial
  state            ads_state      @default(dbgenerated("1"))
  Tactive          Int            @default(300)
  editAds          Int            @default(12)
  arc_msg          String?        @db.VarChar(225)
  country_id       Int?
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  status           Int            @default(1) @db.TinyInt
  data_archive     String?
  data_delete      String?
  price            Float          @default(0)
  edit_date        String?
  sale_type        String?
  price_type       String?
  quantity_offered String?
  delivery_type    String?
  min_price        Float          @default(0)
  max_price        Float          @default(0)
  lat              String?
  lng              String?
  area_id          Int?
  count_share      Int            @default(0)
  subcategory_id   Int?
  end_date_price   String?
  start_date_price String?
  expires_at       DateTime? @db.DateTime(0)

  @@index([category_id], map: "ads_category_id_foreign")
  @@index([city_id], map: "ads_city_id_foreign")
  @@index([user_id], map: "ads_user_id_foreign")
  @@index([expires_at], map: "ads_expires_at")
}

model ads_admins {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  image       Int       @default(0)
}

model ads_chats {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ads_id     Int
  user_id    Int
  chat       String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads_cities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  city_id    Int
  ads_id     Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model ads_prices {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String
  phone       String
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  start_date  String?
  end_date    String?
  image       String?
  video       String?
  views       Int       @default(0)
  count_views Int       @default(0)
  area_id     Int?
  ads         String?   @db.Text
  whatsapp    String?
  user_id     Int?
  transaction Int?
  status      Int       @default(1) @db.TinyInt
}

model ads_views {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
