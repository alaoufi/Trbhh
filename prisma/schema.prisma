  created_at DateTime?       @db.Timestamp(0)
  updated_at DateTime?       @db.Timestamp(0)
  date_edit  String?
  parent_id  Int             @default(0)
  profile_id BigInt?

  @@index([ads_id], map: "comments_ads_id_foreign")
  @@index([sender_id], map: "comments_sender_id_foreign")
}

model contacts {
